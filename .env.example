# Copia este archivo a .env.local y llena tus llaves reales.
# NUNCA subas .env.local a GitHub. Las llaves reales van en Vercel > Settings > Environment Variables.
# Proyecto Supabase ya creado por OSBY:
NEXT_PUBLIC_SUPABASE_URL=https://ewwrbsoltopjswobwbgq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI
# PIN del Panel Master (4-6 dígitos). SOLO en Vercel > Settings >
# Environment Variables, NUNCA en el repo ni con prefijo NEXT_PUBLIC_.
# Sin MASTER_PIN, el Master no se abre. Cámbialo en Vercel y Redeploy.
MASTER_PIN=
# Notificaciones push (Chrome/escritorio) para comunicados de Merlín y
# Corvo. Llaves VAPID: se generan con `npx web-push generate-vapid-keys`.
# La pública va con NEXT_PUBLIC_ (la usa el navegador); la privada SOLO
# en Vercel > Settings > Environment Variables, NUNCA en el repo.
# Sin ellas, el botón "Activar notificaciones" no se ve y el Master no
# manda avisos (el comunicado se publica igual).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://juego-rpg-osby.vercel.app/
# Obtenerlas en Supabase > Project Settings > API
# NEXT_PUBLIC_SITE_URL=https://juego.tudominio.com
